menu "KWS wakeup configuration"

    config KWS_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config KWS_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config KWS_SERVER_URI
        string "KWS WebSocket URI"
        default "ws://114.132.243.95/v1/kws/listen"

    config KWS_DEVICE_ID
        string "KWS device ID"
        default "ESP32-CHEST-001"

    config KWS_PRODUCT_ID
        string "KWS product ID"
        default "eagle"

    config KWS_AUTH_TOKEN
        string "KWS auth token"
        default ""
        help
            Leave empty when KWS_AUTH_ENABLED is false on the backend.

    config KWS_RECONNECT_DELAY_MS
        int "Reconnect delay (ms)"
        range 500 60000
        default 2000

endmenu
